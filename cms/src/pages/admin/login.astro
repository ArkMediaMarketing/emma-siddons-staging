---
import '../../styles/admin.css';
---
<!doctype html><html lang="en-GB"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="referrer" content="no-referrer"/><title>Sign in | Emma Siddons website studio</title></head><body class="login-page"><main class="login-shell"><section class="login-brand"><a class="brand" href="/"><span>Emma Siddons</span><small>Hertfordshire buying agent</small></a><div><p class="eyebrow">YOUR WEBSITE STUDIO</p><h1>A little care,<br/><em>everywhere.</em></h1><p>A personal space to look after your website, at your own pace.</p></div><small>Independent. Local. On your side.</small></section><section class="login-panel"><p class="eyebrow">WEBSITE ADMINISTRATION</p><h2 id="login-title">Welcome back.</h2><p id="login-copy">Sign in to manage your pages, photographs and shared content.</p><form id="login-form"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="username" required/><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="256"/><div id="confirmation" hidden><label for="confirm-password">Confirm password</label><input id="confirm-password" type="password" autocomplete="new-password" maxlength="256"/><small>Use at least 14 characters. A memorable phrase works well.</small></div><p id="login-error" role="alert"></p><button id="login-submit" class="button" type="submit">Sign in</button></form><a class="back-link" href="/">Back to website</a><p class="login-footnote" id="login-footnote">Access is restricted to your website administrator.</p></section></main><script>
const form=document.querySelector('#login-form') as HTMLFormElement;
const setup=location.pathname.includes('/setup');
const params=new URLSearchParams(location.hash.slice(1));
const token=params.get('token')||'';
if(setup&&params.get('email'))(document.querySelector('#email') as HTMLInputElement).value=params.get('email')!;
if(location.hash)history.replaceState(null,'',location.pathname);
const password=document.querySelector('#password') as HTMLInputElement;
const confirmation=document.querySelector('#confirm-password') as HTMLInputElement;
const error=document.querySelector('#login-error') as HTMLElement;
const submit=document.querySelector('#login-submit') as HTMLButtonElement;
if(setup){document.querySelector('#login-title')!.textContent='Make yourself at home.';document.querySelector('#login-copy')!.textContent='Choose a password to activate your private website studio.';document.querySelector('#confirmation')!.removeAttribute('hidden');password.autocomplete='new-password';password.minLength=14;confirmation.required=true;submit.textContent='Create password & open studio';document.querySelector('#login-footnote')!.textContent='This private setup link can be used once and expires after 24 hours.';if(!token){error.textContent='Open the private setup link provided to you, or sign in if you have already created your password.';submit.disabled=true;}}
form.onsubmit=async event=>{event.preventDefault();error.textContent='';if(setup&&password.value!==confirmation.value){error.textContent='The passwords do not match.';return;}submit.disabled=true;try{const response=await fetch(setup?'/auth/setup':'/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:(document.querySelector('#email') as HTMLInputElement).value,password:password.value,...(setup?{token}:{})})});const data=await response.json();if(!response.ok)throw new Error(data.error||'Unable to sign in.');password.value='';confirmation.value='';location.assign('/admin/');}catch(e){error.textContent=e instanceof Error?e.message:'Unable to sign in. Please try again.';submit.disabled=false;}};
</script></body></html>
