    }
  ],
  "vars": {
    "ADMIN_EMAIL": "ben@webdesignessex.io",
    "PUBLIC_SITE_ORIGIN": "https://emma-siddons-admin.tight-darkness-d12f.workers.dev"
  },
  "env": {
